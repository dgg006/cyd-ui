{
  "schema_version": 1,
  "screensaver_timeout": 300,
  "settings": {
    "display": {
      "brightness": 80,
      "auto_brightness": false,
      "minimum_brightness": 5,
      "maximum_brightness": 100,
      "ldr_dark_voltage": 3.0,
      "ldr_bright_voltage": 0.2
    },
    "inactivity": {
      "timeout": 300,
      "mode": "clock_weather",
      "dim_brightness": 10
    },
    "night": {
      "enabled": false,
      "start": "23:00",
      "end": "07:00",
      "brightness": 10,
      "mode": "screen_off"
    },
    "sound": {
      "enabled": true,
      "volume": 5,
      "touch": true,
      "navigation": true,
      "notifications": true,
      "mute_at_night": true,
      "touch_volume": 2,
      "navigation_volume": 2,
      "notification_volume": 5
    },
    "touchscreen": {
      "x_min": 200,
      "x_max": 3700,
      "y_min": 240,
      "y_max": 3800
    }
  },
  "pages": [
    {
      "template": "button_grid",
      "variant": "two_buttons",
      "title": "Inicio",
      "controls": [
        {
          "type": "button",
          "id": "light_1",
          "caption": "Luz 1",
          "icon": "mdi:lightbulb",
          "color": "#1976D2",
          "action": "toggle",
          "meta": {}
        },
        {
          "type": "button",
          "id": "light_2",
          "caption": "Luz 2",
          "icon": "mdi:lightbulb",
          "color": "#F9A825",
          "action": "toggle",
          "meta": {}
        }
      ]
    },
    {
      "template": "clock_weather",
      "variant": "screensaver",
      "title": "",
      "screensaver": true,
      "controls": [
        {
          "type": "value",
          "role": "condition",
          "id": "weather_condition",
          "caption": "Estado",
          "color": "#90CAF9",
          "meta": {}
        },
        {
          "type": "value",
          "role": "outside_temperature",
          "id": "weather_temperature",
          "caption": "Exterior",
          "color": "#FFFFFF",
          "meta": {}
        },
        {
          "type": "value",
          "role": "humidity",
          "id": "weather_humidity",
          "caption": "Humedad",
          "color": "#80CBC4",
          "meta": {}
        }
      ]
    }
  ]
}

