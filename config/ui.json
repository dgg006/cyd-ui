        {"type": "value", "id": "media_player", "caption": "Reproductor", "role": "player", "color": "#FFFFFF", "meta": {}, "unit": ""},
        {"type": "value", "id": "media_title", "caption": "Canción", "role": "title", "color": "#FFFFFF", "meta": {}, "unit": ""},
        {"type": "value", "id": "media_artist", "caption": "Artista", "role": "artist", "color": "#FFFFFF", "meta": {}, "unit": ""},
