        {"type": "button", "id": "media_play_pause", "caption": "Play", "role": "play_pause", "action": "play_pause", "color": "#1976D2", "meta": {}},
        {"type": "button", "id": "media_next", "caption": ">|", "role": "next", "action": "next", "color": "#1976D2", "meta": {}},
