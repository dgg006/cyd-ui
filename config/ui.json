          "color": "#455A64",
          "meta": {}
        },
        {
          "type": "button",
          "role": "power",
          "id": "climate_living_power",
          "caption": "Encender",
          "action": "toggle",
          "color": "#D84315",
          "meta": {}
        },
        {
          "type": "button",
          "role": "increase",
          "id": "climate_living_up",
          "caption": "+",
          "action": "increment",
          "color": "#455A64",
          "meta": {}
        }
