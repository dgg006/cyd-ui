          "unit": "C",
          "color": "#FFB74D",
          "meta": {}
        },
        {
          "type": "value",
          "id": "sensor_bedroom_humidity",
          "caption": "Hum. dormitorio",
          "unit": "%",
          "color": "#81D4FA",
          "meta": {}
        }
      ]
    },
    {
