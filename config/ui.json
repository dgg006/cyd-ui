{
  "schema_version": 1,
  "screensaver_timeout": 300,
  "settings": {
    "display": {
      "brightness": 80,
      "auto_brightness": true,
      "minimum_brightness": 5,
      "maximum_brightness": 100,
      "ldr_dark_voltage": 1.66,
      "ldr_bright_voltage": 0.11
    },
    "appearance": {
      "mode": "dark",
      "accent": "mint"
    },
    "inactivity": {
      "timeout": 300,
      "mode": "clock_weather",
      "dim_brightness": 10
    },
    "night": {
      "enabled": true,
      "start": "23:30",
      "end": "08:00",
      "brightness": 15,
      "mode": "screen_off"
    },
    "sound": {
      "enabled": true,
      "volume": 10,
      "touch": true,
      "navigation": true,
      "notifications": true,
      "mute_at_night": false,
      "touch_volume": 1,
      "navigation_volume": 1,
      "notification_volume": 10
    },
    "touchscreen": {
      "x_min": 240,
      "x_max": 3858,
      "y_min": 165,
      "y_max": 3734
    }
  },
  "pages": [
    {
